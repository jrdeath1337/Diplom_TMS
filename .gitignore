# Файлы состояния Terraform (содержат секреты)
*.tfstate
*.tfstate.*
.terraform/

# Файлы с переменными (могут содержать пароли и токены)
*.tfvars
*.tfvars.json

# Исключаем дашборды из игнорирования
!monitoring-dashboards/*.json

# Локальные файлы конфигурации переопределения (override)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Секретные ключи и env-файлы
*.json
*.env

# Генерируемый Helm values.yaml (формируется Terraform'ом)
helm/hybrid-api/values.yaml

# Кэш Python
__pycache__/
*.pyc

# Артефакты тестирования (pytest)
.pytest_cache/
