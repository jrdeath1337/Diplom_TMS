replicaCount: 2

image:
  repository: cr.yandex/${registry_id}/hybrid-api
  tag: v0.1
  pullPolicy: Always

service:
  type: ClusterIP
  port: 8888

ingress:
  enabled: true
  className: nginx
  host: ${ingress_host}

serviceMonitor:
  enabled: true
  namespace: monitoring
  interval: 15s
  releaseLabel: monitoring
